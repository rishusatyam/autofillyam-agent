{
  "manifest_version": 3,
  "name": "TravelID Autofill Scanner",
  "version": "2.0.0",
  "description": "Scanner V2 - Detects booking fields, filters noise, sends to mapping API",
  "permissions": [
    "activeTab",
    "scripting",
    "downloads"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Scan Page Fields"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": [
        "utils/logger.js",
        "utils/provider.js",
        "utils/visibility.js",
        "utils/dom.js",
        "utils/modeDetector.js",
        "utils/verticalDetector.js",

        "scanner/processors/labelResolver.js",
        "scanner/processors/sectionResolver.js",
        "scanner/processors/relevanceFilter.js",
        "scanner/processors/dedupe.js",
        "scanner/processors/fieldId.js",

        "scanner/detectors/textDetector.js",
        "scanner/detectors/dropdownDetector.js",
        "scanner/detectors/radioDetector.js",
        "scanner/detectors/checkboxDetector.js",
        "scanner/detectors/toggleDetector.js",

        "scanner/index.js",

        "scanner/searchProcessors/containerFinder.js",
        "scanner/searchProcessors/blockExtractor.js",
        "scanner/searchProcessors/labelExtractor.js",
        "scanner/searchProcessors/searchDedupe.js",

        "scanner/searchDetectors/locationDetector.js",
        "scanner/searchDetectors/dateDetector.js",
        "scanner/searchDetectors/counterDetector.js",
        "scanner/searchDetectors/toggleDetector.js",

        "scanner/searchScanner.js",

        "autofill/strategies/textFill.js",
        "autofill/strategies/dropdownFill.js",
        "autofill/strategies/radioFill.js",
        "autofill/strategies/checkboxFill.js",
        "autofill/registry.js",
        "autofill/index.js",

        "autofill/searchHelpers/domHelpers.js",
        "autofill/searchHelpers/waitHelpers.js",

        "autofill/searchStrategies/locationFill.js",
        "autofill/searchStrategies/dateFill.js",
        "autofill/searchStrategies/counterFill.js",
        "autofill/searchStrategies/toggleFill.js",
        "autofill/searchStrategies/dropdownFill.js",

        "autofill/searchAutofill.js",

        "api/mappingClient.js",
        "api/searchMappingClient.js",

        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
