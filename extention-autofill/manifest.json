{
  "manifest_version": 3,
  "name": "TravelID Autofill Scanner",
  "version": "2.0.0",
  "description": "Scanner V2 - Detects booking fields, filters noise, sends to mapping API",
  "permissions": [
    "activeTab",
    "scripting",
    "downloads"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Scan Page Fields"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["utils.js", "scanner.js", "autofill.js", "content.js"],
      "run_at": "document_idle"
    }
  ]
}
