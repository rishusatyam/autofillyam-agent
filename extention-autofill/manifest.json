{
  "manifest_version": 3,
  "name": "TravelID Autofill Scanner",
  "version": "1.0.0",
  "description": "DOM Intelligence Layer - Scans and maps form fields on booking websites",
  "permissions": [
    "activeTab",
    "storage",
    "downloads",
    "scripting"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Scan Page Fields"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["utils.js", "scanner.js", "content.js"],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background.js"
  }
}
